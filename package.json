{
  "name": "pokemon-memory-reader",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "server",
    "viewer",
    "api",
    "internal",
    "bridges"
  ],
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "bun run --workspaces typecheck && tsc --noEmit -p scripts",
    "build:exe": "bun scripts/build-exe.ts --outfile out/pokemon-memory-reader",
    "generate:profiles": "bun scripts/generate-profiles/main.ts",
    "generate:reference": "bun scripts/generate-reference/main.ts",
    "generate:icon-maps": "bun scripts/generate-icon-maps/main.ts",
    "check-icon-map": "bun scripts/check-icon-map.ts",
    "coverage": "bun scripts/coverage.ts",
    "notices": "bun scripts/notices.ts",
    "lgpl-sources": "bun scripts/lgpl-sources.ts",
    "test:local": "bun scripts/test-local.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.2",
    "@types/spdx-expression-parse": "4.0.0",
    "bun-plugin-tailwind": "0.1.2",
    "publint": "0.3.25",
    "spdx-exceptions": "2.5.0",
    "spdx-expression-parse": "4.0.0",
    "spdx-license-ids": "3.0.24",
    "tailwindcss": "4.1.14",
    "typescript": "7.0.2"
  }
}
