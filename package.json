{
  "name": "pokemon-memory-reader",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "server",
    "viewer",
    "api",
    "internal",
    "bridges"
  ],
  "scripts": {
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "bun run --workspaces typecheck && tsc --noEmit -p scripts",
    "build:exe": "bun build --compile --outfile out/pokemon-memory-reader server/src/main.ts",
    "generate:profiles": "bun scripts/generate-profiles/main.ts",
    "generate:reference": "bun scripts/generate-reference/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
